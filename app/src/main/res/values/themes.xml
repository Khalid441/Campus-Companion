<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CampusCompanion" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
    </style>

    <style name="Theme.CampusCompanion" parent="Base.Theme.CampusCompanion" />

    <!-- Invisible hop used by the old tab entry points (they forward to MainActivity) -->
    <style name="Theme.CampusCompanion.Trampoline" parent="Theme.CampusCompanion">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Launch screen: logo on deep purple, then switches to the normal theme -->
    <style name="Theme.CampusCompanion.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#2E1F7A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CampusCompanion</item>
    </style>

    <!-- Rounded highlight behind the selected bottom-bar icon -->
    <style name="Widget.CampusCompanion.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_indicator</item>
        <item name="android:width">60dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>
</resources>