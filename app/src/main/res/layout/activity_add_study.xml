<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New study session"
            android:textColor="@color/study_teal"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Your own study time. This is not a university class."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Subject (e.g. CSE 2209)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSubject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTopic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="What will you study? (optional)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Repeat on"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSun"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sun"
                    android:textColor="@color/study_chip_text"
                    app:checkedIconTint="@android:color/white"
                    app:chipBackgroundColor="@color/study_chip_bg"
                    app:chipStrokeWidth="0dp" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMon"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mon"
                    android:textColor="@color/study_chip_text"
                    app:checkedIconTint="@android:color/white"
                    app:chipBackgroundColor="@color/study_chip_bg"
                    app:chipStrokeWidth="0dp" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTue"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tue"
                    android:textColor="@color/study_chip_text"
                    app:checkedIconTint="@android:color/white"
                    app:chipBackgroundColor="@color/study_chip_bg"
                    app:chipStrokeWidth="0dp" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWed"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wed"
                    android:textColor="@color/study_chip_text"
                    app:checkedIconTint="@android:color/white"
                    app:chipBackgroundColor="@color/study_chip_bg"
                    app:chipStrokeWidth="0dp" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipThu"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thu"
                    android:textColor="@color/study_chip_text"
                    app:checkedIconTint="@android:color/white"
                    app:chipBackgroundColor="@color/study_chip_bg"
                    app:chipStrokeWidth="0dp" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFri"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fri"
                    android:textColor="@color/study_chip_text"
                    app:checkedIconTint="@android:color/white"
                    app:chipBackgroundColor="@color/study_chip_bg"
                    app:chipStrokeWidth="0dp" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSat"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sat"
                    android:textColor="@color/study_chip_text"
                    app:checkedIconTint="@android:color/white"
                    app:chipBackgroundColor="@color/study_chip_bg"
                    app:chipStrokeWidth="0dp" />
        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEveryDay"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Every day"
                android:textColor="@color/study_teal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSunThu"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sun &#8211; Thu"
                android:textColor="@color/study_teal" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Time"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnd"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Remind me"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsRemind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="true"
            app:singleSelection="true">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRNone"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No reminder"
                    android:textColor="@color/study_chip_text"
                    android:tag="-1"
                    app:checkedIconTint="@android:color/white"
                    app:chipBackgroundColor="@color/study_chip_bg"
                    app:chipStrokeWidth="0dp" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipR0"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="At start"
                    android:textColor="@color/study_chip_text"
                    android:tag="0"
                    app:checkedIconTint="@android:color/white"
                    app:chipBackgroundColor="@color/study_chip_bg"
                    app:chipStrokeWidth="0dp" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipR5"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 min before"
                    android:textColor="@color/study_chip_text"
                    android:tag="5"
                    app:checkedIconTint="@android:color/white"
                    app:chipBackgroundColor="@color/study_chip_bg"
                    app:chipStrokeWidth="0dp" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipR10"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 min before"
                    android:textColor="@color/study_chip_text"
                    android:tag="10"
                    android:checked="true"
                    app:checkedIconTint="@android:color/white"
                    app:chipBackgroundColor="@color/study_chip_bg"
                    app:chipStrokeWidth="0dp" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipR15"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 min before"
                    android:textColor="@color/study_chip_text"
                    android:tag="15"
                    app:checkedIconTint="@android:color/white"
                    app:chipBackgroundColor="@color/study_chip_bg"
                    app:chipStrokeWidth="0dp" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipR30"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30 min before"
                    android:textColor="@color/study_chip_text"
                    android:tag="30"
                    app:checkedIconTint="@android:color/white"
                    app:chipBackgroundColor="@color/study_chip_bg"
                    app:chipStrokeWidth="0dp" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/study_teal"
            android:text="Save study session"
            android:textColor="@android:color/white"
            app:cornerRadius="20dp" />
    </LinearLayout>
</ScrollView>
