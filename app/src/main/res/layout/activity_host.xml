<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Bottom overlay: offline banner + floating bar. Content scrolls behind it. -->
    <LinearLayout
        android:id="@+id/navOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

    <TextView
        android:id="@+id/tvOffline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF37474F"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="You're offline. Attendance, notes and deadlines still work."
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:visibility="gone"
        android:accessibilityLiveRegion="polite" />

    <!-- Floating pill bottom bar: rounded translucent card with icon + small label tabs -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/nav_bar_bg"
            app:cardCornerRadius="36dp"
            app:cardElevation="10dp"
            app:strokeColor="@color/nav_bar_stroke"
            app:strokeWidth="1dp">

            <com.example.campuscompanion.view.FloatingNavBar
                android:id="@+id/bottomNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
    </LinearLayout>
</FrameLayout>
